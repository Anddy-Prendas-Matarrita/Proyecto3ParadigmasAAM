cabal-version:      2.4
name:               pipeline-fl
version:            0.1.0.0
build-type:         Simple

executable pipeline
    main-is:          Main.hs
    hs-source-dirs:   app, src
    other-modules:    Types
                      Parser
                      FileIO
                      Validator
                      PrologGen
                      QueryGen
                      HtmlGen
    build-depends:    base >=4 && <5
                    , directory
    default-language: Haskell2010
    ghc-options:      -Wall